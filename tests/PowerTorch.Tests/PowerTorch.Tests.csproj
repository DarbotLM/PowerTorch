<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PowerTorch.Abstractions\PowerTorch.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\PowerTorch.Core\PowerTorch.Core.csproj" />
    <ProjectReference Include="..\..\src\PowerTorch.Cpu\PowerTorch.Cpu.csproj" />
    <ProjectReference Include="..\..\src\PowerTorch.DirectML\PowerTorch.DirectML.csproj" />
    <ProjectReference Include="..\..\src\PowerTorch.Serialization\PowerTorch.Serialization.csproj" />
    <ProjectReference Include="..\..\src\PowerTorch.Autograd\PowerTorch.Autograd.csproj" />
    <ProjectReference Include="..\..\src\PowerTorch.Optim\PowerTorch.Optim.csproj" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\artifacts\native\$(Configuration)\PowerTorch.DirectML.Native.dll')">
    <None Include="$(MSBuildThisFileDirectory)..\..\artifacts\native\$(Configuration)\PowerTorch.DirectML.Native.dll" Link="PowerTorch.DirectML.Native.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
